    "ag-ui",
    "chat",
    "llm",
    "openai",
    "streaming",
    "ui",
    "widget"
  ],
  "homepage": "https://github.com/vemonet/light-chat#readme",
  "bugs": "https://github.com/vemonet/light-chat/issues",
  "license": "MIT",
  "author": "Vincent Emonet <vincent.emonet@sib.swiss>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vemonet/light-chat.git",
    "directory": "packages/js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
